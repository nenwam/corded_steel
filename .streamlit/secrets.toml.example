# Copy to `.streamlit/secrets.toml` for local use, or paste the contents into
# Streamlit Cloud under App settings → Secrets.
#
# Leave this out entirely and the app falls back to the local `cordedsteel.db`
# file, which is what you want while developing.

[turso]
url = "libsql://your-database-your-org.turso.io"
auth_token = "paste-the-token-from-`turso db tokens create`"
